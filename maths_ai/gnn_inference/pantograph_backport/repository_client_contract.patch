diff --git a/Pantograph/Diagnostics.lean b/Pantograph/Diagnostics.lean
new file mode 100644
index 0000000..80fa9ca
--- /dev/null
+++ b/Pantograph/Diagnostics.lean
@@ -0,0 +1,58 @@
+import Pantograph.Protocol
+import Lean
+
+namespace Pantograph
+open Lean
+
+private def messageKind : MessageData → Name
+  | .tagged name _ => name
+  | .withContext _ data | .withNamingContext _ data | .nest _ data
+  | .group data | .ofWidget _ data => messageKind data
+  | _ => .anonymous
+
+/-- Elaborate source strings against their actual source map. -/
+def withInputContext (input : String) (action : Elab.TermElabM α) : Elab.TermElabM α :=
+  withTheReader Core.Context (fun ctx =>
+    { ctx with fileName := "<pantograph>", fileMap := input.toFileMap }) action
+
+/-- Render diagnostics without introducing source locations absent from Lean. -/
+def renderMessages (log : MessageLog) : CoreM (Array Protocol.Message) := do
+  log.toArray.mapM fun message => do
+    let context ← read
+    let known := message.pos.line > 0 && !context.fileMap.source.isEmpty && message.fileName == context.fileName
+    let pos : Protocol.MessagePos := if known then
+      { line := message.pos.line, column := message.pos.column } else {}
+    let endPos? := message.endPos.bind fun p =>
+      if known && (p.line > pos.line || (p.line == pos.line && p.column >= pos.column)) then
+        some { line := p.line, column := p.column } else none
+    return {
+      kind := (messageKind message.data).toString,
+      severity := match message.severity with
+        | .information => "information"
+        | .warning => "warning"
+        | .error => "error",
+      pos, endPos?, data := ← message.data.toString
+    }
+
+private def convSequence : Parser.Parser :=
+  Parser.node ``Parser.Tactic.Conv.convSeq <|
+    (Parser.node ``Parser.Tactic.Conv.convSeqBracketed <|
+      Parser.symbol "{" >> Parser.withoutPosition
+        (Parser.Tactic.sepByIndentSemicolon (Parser.categoryParser `conv 0)) >> Parser.symbol "}") <|>
+    (Parser.node ``Parser.Tactic.Conv.convSeq1Indented <|
+      Parser.Tactic.sepBy1IndentSemicolon (Parser.categoryParser `conv 0))
+
+/-- Parse a full selected-mode sequence, including the final end-of-input check. -/
+def parseTacticSequence (env : Environment) (isConv : Bool) (input : String) : Except String Syntax :=
+  let parser := if isConv then convSequence else Parser.Tactic.tacticSeq
+  let context := Parser.mkInputContext input "<pantograph>"
+  let state := (Parser.andthenFn Parser.whitespace parser.fn).run context
+    { env, options := {} } (Parser.getTokenTable env) (Parser.mkParserState input)
+  if !state.allErrors.isEmpty then
+    .error (state.toErrorMsg context)
+  else if context.input.atEnd state.pos then
+    .ok state.stxStack.back
+  else
+    .error ((state.mkError "end of input").toErrorMsg context)
+
+end Pantograph
diff --git a/Pantograph/Validation.lean b/Pantograph/Validation.lean
new file mode 100644
index 0000000..5ea55e9
--- /dev/null
+++ b/Pantograph/Validation.lean
@@ -0,0 +1,129 @@
+import Pantograph.Goal
+
+namespace Pantograph
+open Lean
+
+/-- Evidence produced by inspecting one transition's elaborated expressions. -/
+structure CheckedTransition where
+  state : GoalState
+  hasSorry : Bool
+  hasUnsafe : Bool
+
+private structure Scan where
+  mvars : Lean.HashSet (MVarId × Bool) := {}
+  fvars : Lean.HashSet (FVarId × Bool) := {}
+  constants : Lean.HashSet (Name × Bool) := {}
+  activeMVars : Lean.HashSet MVarId := {}
+  unresolved : Array MVarId := #[]
+  hasSorry : Bool := false
+  hasUnsafe : Bool := false
+
+private abbrev ScanM := StateT Scan (Except String)
+
+mutual
+  private partial def inspectExpr (before : Environment) (after : Environment)
+      (mctx : MetavarContext) (track : Bool) (lctx : LocalContext) (expr : Expr) : ScanM Unit := do
+    if expr.hasSorry then modify fun s => { s with hasSorry := true }
+    match expr with
+    | .mvar id => inspectMVar before after mctx track id
+    | .fvar id =>
+      unless (← get).fvars.contains (id, track) do
+        modify fun s => { s with fvars := s.fvars.insert (id, track) }
+        let some decl := lctx.find? id | throw s!"Missing local declaration {id.name}"
+        inspectExpr before after mctx track lctx decl.type
+        if let some value := decl.value? then inspectExpr before after mctx track lctx value
+    | .const name _ =>
+      unless (← get).constants.contains (name, track) do
+        modify fun s => { s with constants := s.constants.insert (name, track) }
+        let some info := after.find? name | throw s!"Missing proof dependency {name}"
+        if info.isUnsafe then modify fun s => { s with hasUnsafe := true }
+        -- Imported declarations remain the fixed trust basis.
+        unless (before.find? name).isSome do
+          inspectExpr before after mctx track {} info.type
+          if let some value := info.value? then inspectExpr before after mctx track {} value
+    | .app fn arg =>
+      inspectExpr before after mctx track lctx fn
+      inspectExpr before after mctx track lctx arg
+    | .lam _ type body _ | .forallE _ type body _ =>
+      inspectExpr before after mctx track lctx type
+      inspectExpr before after mctx track lctx body
+    | .letE _ type value body _ =>
+      inspectExpr before after mctx track lctx type
+      inspectExpr before after mctx track lctx value
+      inspectExpr before after mctx track lctx body
+    | .mdata _ body => inspectExpr before after mctx track lctx body
+    | .proj name index body =>
+      let some field := (getStructureFields after name).get? index | throw s!"Missing projection field {name}.{index}"
+      let some projector := getProjFnForField? after name field | throw s!"Missing projection dependency {name}.{field}"
+      inspectExpr before after mctx track lctx (.const projector [])
+      inspectExpr before after mctx track lctx body
+    | _ => pure ()
+
+  private partial def inspectContext (before : Environment) (after : Environment)
+      (mctx : MetavarContext) (track : Bool) (decl : MetavarDecl) : ScanM Unit := do
+    inspectExpr before after mctx track decl.lctx decl.type
+    for localDecl in decl.lctx do
+      inspectExpr before after mctx track decl.lctx (.fvar localDecl.fvarId)
+
+  private partial def inspectMVar (before : Environment) (after : Environment)
+      (mctx : MetavarContext) (track : Bool) (id : MVarId) : ScanM Unit := do
+    if (← get).activeMVars.contains id then throw s!"Cyclic metavariable assignment {id.name}"
+    unless (← get).mvars.contains (id, track) do
+      modify fun s => { s with mvars := s.mvars.insert (id, track) }
+      let some decl := mctx.findDecl? id | throw s!"Missing metavariable declaration {id.name}"
+      inspectContext before after mctx (track && !mctx.eAssignment.contains id && !mctx.dAssignment.contains id) decl
+      if let some value := mctx.eAssignment.find? id then
+        modify fun s => { s with activeMVars := s.activeMVars.insert id }
+        inspectExpr before after mctx track decl.lctx value
+        modify fun s => { s with activeMVars := s.activeMVars.erase id }
+      else if let some delayed := mctx.dAssignment.find? id then
+        let some pending := mctx.findDecl? delayed.mvarIdPending | throw "Missing delayed assignment target"
+        for value in delayed.fvars do inspectExpr before after mctx track pending.lctx value
+        modify fun s => { s with activeMVars := s.activeMVars.insert id }
+        inspectMVar before after mctx track delayed.mvarIdPending
+        modify fun s => { s with activeMVars := s.activeMVars.erase id }
+      else if track then
+        modify fun s => { s with unresolved := s.unresolved.push id }
+end
+
+/-- Inspect changed assignments, reachable dependencies and new local contexts.
+    Unresolved reachable holes become goals; existing dormant siblings keep their mode semantics. -/
+def validateTransition (before after : GoalState) (selected : MVarId) : Except String CheckedTransition := do
+  let action : ScanM Unit := do
+    inspectMVar before.trustedEnv after.env after.mctx true selected
+    for goal in before.goals do inspectMVar before.trustedEnv after.env after.mctx true goal
+    for goal in after.goals do inspectMVar before.trustedEnv after.env after.mctx true goal
+    let changed := after.mctx.eAssignment.foldl (init := #[]) fun acc id value =>
+      if (before.mctx.eAssignment.find? id).any (Expr.equal value) then acc else acc.push id
+    for id in changed do inspectMVar before.trustedEnv after.env after.mctx false id
+    let delayed := after.mctx.dAssignment.foldl (init := #[]) fun acc id value =>
+      match before.mctx.dAssignment.find? id with
+      | some old => if old.mvarIdPending == value.mvarIdPending && old.fvars == value.fvars then acc else acc.push id
+      | none => acc.push id
+    for id in delayed do inspectMVar before.trustedEnv after.env after.mctx false id
+    -- New contexts can contain admissions in let values even if the final proof ignores them.
+    let contexts := after.mctx.decls.foldl (init := #[]) fun acc id decl =>
+      if before.mctx.decls.contains id then acc else acc.push decl
+    for decl in contexts do inspectContext before.trustedEnv after.env after.mctx false decl
+    for id in after.savedState.term.elab.pendingMVars do
+      inspectMVar before.trustedEnv after.env after.mctx false id
+  let (_, evidence) ← action.run {}
+  let dormant := before.goals.filter (· != selected)
+  let conversion := after.convMVar?.map (fun (rhs, goal, siblings) => rhs :: goal :: siblings) |>.getD []
+  -- A retained conversion equation owns its evolving right-hand expression.
+  let conversion := after.goals.foldl (init := conversion) fun acc goal =>
+    match after.mctx.findDecl? goal with
+    | some decl =>
+      if (isLHSGoal? decl.type).isSome then
+        let (rhs, _) := instantiateMVarsCore after.mctx decl.type.consumeMData.appArg!
+        acc ++ (rhs.collectMVars {}).result.toList
+      else acc
+    | none => acc
+  let extra := evidence.unresolved.toList.filter fun id =>
+    !after.goals.contains id && !dormant.contains id && !conversion.contains id
+  let state := { after with savedState := {
+    after.savedState with tactic := { goals := after.goals ++ extra }
+  } }
+  return { state, hasSorry := evidence.hasSorry, hasUnsafe := evidence.hasUnsafe }
+
+end Pantograph
diff --git a/Test/ContractFixtures.lean b/Test/ContractFixtures.lean
new file mode 100644
index 0000000..e0bf327
--- /dev/null
+++ b/Test/ContractFixtures.lean
@@ -0,0 +1,89 @@
+import Pantograph
+
+open Lean Elab Tactic
+
+/-- Test-only operation that reaches the unsafe scanner with an elaborated assignment. -/
+elab "contract_unsafe" : tactic => do
+  let name := `ContractFixtures.unsafeProof
+  let info : DefinitionVal := {
+    name, levelParams := [], type := mkConst ``True,
+    value := mkConst ``True.intro, hints := .opaque, safety := .unsafe
+  }
+  addDecl (.defnDecl info)
+  (← getMainGoal).assign (mkConst name)
+  setGoals []
+
+/-- A new safe dependency whose value contains an admission. -/
+elab "contract_dependency_sorry" : tactic => do
+  let value ← Meta.mkSorry (mkConst ``True) false
+  let name := `ContractFixtures.admittedProof
+  let info : DefinitionVal := {
+    name, levelParams := [], type := mkConst ``True,
+    value, hints := .opaque, safety := .safe
+  }
+  addDecl (.defnDecl info)
+  (← getMainGoal).assign (mkConst name)
+  setGoals []
+
+/-- Deliberately remove a reachable proof hole from the visible list. -/
+elab "contract_hidden_hole" : tactic => do
+  let goal ← getMainGoal
+  let hole ← Meta.mkFreshExprSyntheticOpaqueMVar (← goal.getType)
+  goal.assign hole
+  setGoals []
+
+/-- Mutate the environment and close the goal before reporting a logged error. -/
+elab "contract_failed_mutation" : tactic => do
+  let info : DefinitionVal := {
+    name := `ContractFixtures.failedMutation, levelParams := [], type := mkConst ``True,
+    value := mkConst ``True.intro, hints := .opaque, safety := .safe
+  }
+  addDecl (.defnDecl info)
+  (← getMainGoal).assign (mkConst ``True.intro)
+  setGoals []
+  discard <| Meta.inferType (mkConst `ContractFixtures.failedMutation)
+  logError "mutation must roll back"
+
+/-- Keep a newly introduced declaration in a partial state for a later tactic. -/
+elab "contract_store_admission" : tactic => do
+  let value ← Meta.mkSorry (mkConst ``True) false
+  addDecl (.defnDecl {
+    name := `ContractFixtures.storedAdmission, levelParams := [], type := mkConst ``True,
+    value, hints := .opaque, safety := .safe
+  })
+
+/-- A tagged diagnostic verifies that the wire kind comes from the message data. -/
+elab "contract_tagged_warning" : tactic => do
+  logWarning (.tagged `ContractFixtures.warningKind m!"tagged warning")
+
+/-- Reuse a failed declaration's name with a different type to test cache rollback. -/
+elab "contract_reuse_failed_name" : tactic => do
+  let name := `ContractFixtures.failedMutation
+  addDecl (.defnDecl {
+    name, levelParams := [], type := mkConst ``Nat,
+    value := mkNatLit 0, hints := .opaque, safety := .safe
+  })
+  unless (← Meta.inferType (mkConst name)).isConstOf ``Nat do
+    throwError "failed declaration type cache leaked"
+  (← getMainGoal).assign (mkConst name)
+  setGoals []
+
+/-- A delayed assignment whose pending proof was omitted from the goal list. -/
+elab "contract_delayed_hole" : tactic => do
+  let goal ← getMainGoal
+  let pending ← Meta.mkFreshExprSyntheticOpaqueMVar (← goal.getType)
+  assignDelayedMVar goal #[] pending.mvarId!
+  setGoals []
+
+/-- Missing assignment declarations must produce a named validation error. -/
+elab "contract_missing_assignment" : tactic => do
+  (← getMainGoal).assign (.mvar ⟨`ContractFixtures.missingAssignment⟩)
+  setGoals []
+
+/-- A reachable unresolved let value must survive a closed visible goal list. -/
+elab "contract_hidden_local_value" : tactic => withMainContext do
+  let goal ← getMainGoal
+  let hole ← Meta.mkFreshExprSyntheticOpaqueMVar (mkConst ``True)
+  Meta.withLetDecl `hiddenValue (mkConst ``True) hole fun value => do
+    goal.assign (← Meta.mkLetFVars #[value] value)
+  setGoals []
diff --git a/Test/Validation.lean b/Test/Validation.lean
new file mode 100644
index 0000000..7612c84
--- /dev/null
+++ b/Test/Validation.lean
@@ -0,0 +1,155 @@
+import Test.Common
+import Test.ContractFixtures
+import Pantograph.Validation
+import Repl
+
+namespace Pantograph.Test.Validation
+open Lean Pantograph.Repl
+
+private def request (cmd : String) (fields : List (String × Json)) : MainM Json :=
+  Repl.execute { cmd, payload := Json.mkObj fields }
+
+private def start (expr : String) : MainM Nat := do
+  let result ← request "goal.start" [("expr", .str expr)]
+  match result.getObjValAs? Nat "stateId" with
+  | .ok id => pure id
+  | .error _ => throwError "goal.start failed: {result}"
+
+private def tactic (id : Nat) (text : String) (index : Nat := 0) : MainM Json :=
+  request "goal.tactic" [("stateId", toJson id), ("goalId", toJson index), ("tactic", .str text)]
+
+private def success (result : Json) : Bool :=
+  (result.getObjValAs? Nat "nextStateId").isOk &&
+  ((result.getObjVal? "validation").bind (·.getObjValAs? Bool "checked")).toOption == some true
+
+private def rejection (result : Json) : Bool :=
+  (result.getObjValAs? (Array String) "tacticErrors").isOk &&
+  !(result.getObjVal? "nextStateId").isOk &&
+  (result.getObjValAs? Bool "hasSorry").toOption == some false &&
+  (result.getObjValAs? Bool "hasUnsafe").toOption == some false
+
+private def goals (result : Json) : Array Json :=
+  result.getObjValAs? (Array Json) "goals" |>.toOption |>.getD #[]
+
+private def protocolTests : MainM LSpec.TestSeq := do
+  let mut tests := LSpec.TestSeq.done
+  let descriptor ← request "protocol.describe" []
+  tests := tests ++ LSpec.test "exact descriptor" (descriptor == toJson ({} : Protocol.ProtocolDescriptor))
+  let failedStart ← request "goal.start" [("expr", .str "(by run_tac Lean.logError \"start failure\"; exact True)")]
+  tests := tests ++ LSpec.test "logged start errors reject state allocation" ((failedStart.getObjValAs? String "error").toOption == some "elab")
+  tests := tests ++ LSpec.test "failed start allocated no state" ((← get).goalStates.isEmpty)
+  let root ← start "True"
+  let valid ← tactic root "trivial"
+  tests := tests ++ LSpec.test "valid completed transition" (success valid && (goals valid).isEmpty)
+  let skipped ← tactic root "skip"
+  tests := tests ++ LSpec.test "skip preserves the open goal" (success skipped && (goals skipped).size == 1)
+  let multiline ← start "∀ (p : Prop), p → p"
+  let result ← tactic multiline "intro p h\nexact h"
+  tests := tests ++ LSpec.test "complete multiline tactic sequence" (success result && (goals result).isEmpty)
+  let bad ← tactic root "trivial\nthis_is_not_a_tactic"
+  tests := tests ++ LSpec.test "trailing input rejected" ((bad.getObjValAs? String "parseError").isOk)
+  let bad ← tactic root "exact Nat.zero"
+  tests := tests ++ LSpec.test "ordinary type failure" (rejection bad)
+  let bad ← tactic root "run_tac Lean.logError \"capture error\" <;> trivial"
+  tests := tests ++ LSpec.test "logged error rejects completed tactic" (rejection bad)
+  let messages := bad.getObjValAs? (Array Protocol.Message) "messages" |>.toOption |>.getD #[]
+  tests := tests ++ LSpec.test "real error has source position" (messages.any fun m => m.pos.line == 1 && m.data == "capture error")
+  let bad ← tactic root "contract_failed_mutation"
+  tests := tests ++ LSpec.test "failed mutation rejected" (rejection bad)
+  let inspected ← request "env.inspect" [("name", .str "ContractFixtures.failedMutation")]
+  tests := tests ++ LSpec.test "failed environment mutation rolled back" ((inspected.getObjVal? "error").isOk)
+  let natRoot ← start "Nat"
+  discard <| tactic natRoot "contract_failed_mutation"
+  let reused ← tactic natRoot "contract_reuse_failed_name"
+  tests := tests ++ LSpec.test "failed declaration cache rolled back" (success reused && (goals reused).isEmpty)
+  let result ← tactic root "trivial"
+  tests := tests ++ LSpec.test "original state reusable after failures" (success result && (goals result).isEmpty)
+  let result ← tactic root "run_tac Lean.logWarning \"warning evidence\"\nrun_tac Lean.logInfo \"information evidence\"\ntrivial"
+  let messages := result.getObjValAs? (Array Protocol.Message) "messages" |>.toOption |>.getD #[]
+  tests := tests ++ LSpec.test "warning/information survive success" (success result &&
+    messages.any (fun m => m.severity == "warning" && m.data == "warning evidence") &&
+    messages.any (fun m => m.severity == "information" && m.data == "information evidence"))
+  let result ← tactic root "trivial"
+  tests := tests ++ LSpec.test "messages do not leak to following request" ((result.getObjValAs? (Array Protocol.Message) "messages").toOption == some #[])
+  for text in ["sorry", "exact (by sorry)", "have h : True := by sorry\nexact h", "contract_dependency_sorry"] do
+    let result ← tactic root text
+    tests := tests ++ LSpec.test s!"admission detected: {text}" (success result && (result.getObjValAs? Bool "hasSorry").toOption == some true)
+  let result ← tactic root "contract_unsafe"
+  tests := tests ++ LSpec.test "positive unsafe scanner evidence" (success result && (result.getObjValAs? Bool "hasUnsafe").toOption == some true)
+  let stored ← tactic root "contract_store_admission"
+  let storedId := stored.getObjValAs? Nat "nextStateId" |>.toOption |>.getD root
+  let used ← tactic storedId "exact ContractFixtures.storedAdmission"
+  tests := tests ++ LSpec.test "introduced declarations retain original trust boundary" (success used &&
+    (used.getObjValAs? Bool "hasSorry").toOption == some true)
+  let inspected ← request "env.inspect" [("name", .str "ContractFixtures.storedAdmission")]
+  tests := tests ++ LSpec.test "serialization does not leak successful environment mutations" ((inspected.getObjVal? "error").isOk)
+  let tagged ← tactic root "contract_tagged_warning"
+  let messages := tagged.getObjValAs? (Array Protocol.Message) "messages" |>.toOption |>.getD #[]
+  tests := tests ++ LSpec.test "message kind preserved" (messages.any fun m => m.kind == "ContractFixtures.warningKind")
+  let result ← tactic root "contract_hidden_hole"
+  tests := tests ++ LSpec.test "hidden reachable hole becomes a goal" (success result && (goals result).size == 1)
+  let id := result.getObjValAs? Nat "nextStateId" |>.toOption |>.getD root
+  let closed ← tactic id "trivial"
+  tests := tests ++ LSpec.test "restored hidden hole can be solved" (success closed && (goals closed).isEmpty)
+  let localHole ← tactic root "contract_hidden_local_value"
+  tests := tests ++ LSpec.test "hidden local value remains an obligation" (success localHole && (goals localHole).size == 1)
+  let delayed ← tactic root "contract_delayed_hole"
+  tests := tests ++ LSpec.test "delayed hole restored through the protocol" (success delayed && (goals delayed).size == 1)
+  let missing ← tactic root "contract_missing_assignment"
+  tests := tests ++ LSpec.test "missing assignment returns named validation error" ((missing.getObjValAs? String "error").toOption == some "validation" && !(missing.getObjVal? "nextStateId").isOk)
+  let conjunction ← start "True ∧ True"
+  let split ← tactic conjunction "constructor"
+  let id := split.getObjValAs? Nat "nextStateId" |>.toOption |>.getD conjunction
+  let second ← tactic id "trivial" 1
+  tests := tests ++ LSpec.test "nonzero selection preserves sibling" (success second && (goals second).size == 1)
+  let ids := (← get).goalStates.toList.map (·.1)
+  discard <| request "goal.delete" [("stateIds", toJson ids)]
+  let count ← request "stat" []
+  tests := tests ++ LSpec.test "all test allocations deleted" ((count.getObjValAs? Nat "nGoals").toOption == some 0)
+  return tests
+
+private def boundaryTests : Elab.TermElabM LSpec.TestSeq := do
+  let mut tests := LSpec.TestSeq.done
+  let state ← GoalState.create (mkConst ``True)
+  let sibling ← Meta.mkFreshExprSyntheticOpaqueMVar (mkConst ``True)
+  let state ← GoalState.createFromMVars [state.root, sibling.mvarId!] state.root
+  let .success next ← state.tryTacticM state.root (do
+      let value ← Meta.mkSorry (mkConst ``True) false
+      sibling.mvarId!.assign value
+      Elab.Tactic.setGoals [state.root]) | throwError "coupled tactic failed"
+  let checked := validateTransition state next state.root
+  tests := tests ++ LSpec.test "changed coupled assignment scanned" (checked.toOption.any (·.hasSorry))
+  let state ← GoalState.create (mkConst ``True)
+  let .success next ← state.tryTacticM state.root (do
+      let pending ← Meta.mkFreshExprSyntheticOpaqueMVar (mkConst ``True)
+      assignDelayedMVar state.root #[] pending.mvarId!
+      Elab.Tactic.setGoals []) | throwError "delayed tactic failed"
+  let checked := validateTransition state next state.root
+  tests := tests ++ LSpec.test "delayed pending obligation retained" (checked.toOption.any fun result => result.state.goals.length == 1)
+  let missing : MVarId := ⟨`ContractFixtures.missing⟩
+  let corrupted := { state with savedState := { state.savedState with tactic := { goals := [missing] } } }
+  tests := tests ++ LSpec.test "missing evidence produces validation failure" (!(validateTransition state corrupted state.root).isOk)
+  let cyclic := { state with savedState := { state.savedState with term := {
+    state.savedState.term with meta := { state.savedState.term.meta with meta := {
+      state.metaState with mctx := { state.mctx with eAssignment := state.mctx.eAssignment.insert state.root (.mvar state.root) }
+    } }
+  } } }
+  tests := tests ++ LSpec.test "cyclic assignments reject indeterminate evidence" (!(validateTransition state cyclic state.root).isOk)
+  logInfo "outer log"
+  let outer := (← getThe Core.State).messages
+  let .failure _ _ ← state.tryTacticM state.root (do
+      (← Elab.Tactic.getMainGoal).assign (mkConst ``True.intro)
+      logError "inner failure") | throwError "shared operation accepted logged error"
+  let current := (← getThe Core.State).messages
+  tests := tests ++ LSpec.test "outer message log restored" (current.toArray.size == outer.toArray.size)
+  tests := tests ++ LSpec.test "failed assignment restored" (!(← getMCtx).eAssignment.contains state.root)
+  return tests
+
+def suite (env : Environment) : List (String × IO LSpec.TestSeq) := [
+  ("Transition boundary", runTermElabMSeq env boundaryTests),
+  ("Protocol diagnostics and checks", do
+    let env ← importModules #[{ module := `Test.ContractFixtures }] {} (trustLevel := 1)
+    runCoreMSeq env (protocolTests.run { imports := ["Test.ContractFixtures"] } |>.run' {}))
+]
+
+end Pantograph.Test.Validation
diff --git a/scripts/capture_repository_client_contract.py b/scripts/capture_repository_client_contract.py
new file mode 100644
index 0000000..925b77b
--- /dev/null
+++ b/scripts/capture_repository_client_contract.py
@@ -0,0 +1,220 @@
+#!/usr/bin/env python3
+"""Capture Stage 4 wire evidence and check it against the existing application codec.
+
+Run with the application's Python environment. Output must be a new directory.
+Historical captures are read as replay inputs and are never modified.
+"""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+BASE = "0dd5d2225e2d093f66a4b6231c1aa35004f2c8f3"
+
+
+async def capture(args):
+    repo = args.repo.resolve()
+    application = args.application.resolve()
+    fixtures = application / "maths_ai/gnn_inference/tests/fixtures/pantograph"
+    sys.path.insert(0, str(application))
+    from maths_ai.hybrid_reasoner.pantograph_protocol import (
+        decode_json_response, decode_response, decode_execution_goal,
+    )
+    from maths_ai.gnn_inference.atp_lean_gnn.graph import dag_fingerprint, model_goal_to_dag
+
+    assert subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip() == BASE
+    toolchain = (repo / "lean-toolchain").read_text().strip()
+    assert toolchain == (args.mathlib / "lean-toolchain").read_text().strip()
+    env = os.environ.copy()
+    mathlib_path = subprocess.check_output(
+        ["lake", "env", "printenv", "LEAN_PATH"], cwd=args.mathlib, text=True,
+    ).strip()
+    own_path = subprocess.check_output(
+        ["lake", "env", "printenv", "LEAN_PATH"], cwd=repo, text=True,
+    ).strip()
+    # Lake may return relative package paths; resolve them against each owning project.
+    def absolute_paths(value, owner):
+        return os.pathsep.join(str((owner / p).resolve()) if not Path(p).is_absolute() else p
+                               for p in value.split(os.pathsep) if p)
+    env["LEAN_PATH"] = absolute_paths(own_path, repo) + os.pathsep + absolute_paths(mathlib_path, args.mathlib)
+    repl = repo / ".lake/build/bin/repl"
+    proc = await asyncio.create_subprocess_exec(
+        "stdbuf", "-oL", str(repl), "Mathlib", "Test.ContractFixtures",
+        cwd=repo, env=env, stdin=asyncio.subprocess.PIPE,
+        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE,
+    )
+    stderr_task = asyncio.create_task(proc.stderr.read())
+    entries = []
+    allocated = set()
+    graph_checks = []
+    try:
+        ready = (await asyncio.wait_for(proc.stdout.readline(), 30)).decode().rstrip("\n")
+        assert ready == "ready.", ready
+
+        async def call(label, command, payload, *, owned=True):
+            line = command + " " + json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
+            proc.stdin.write((line + "\n").encode())
+            await proc.stdin.drain()
+            response_line = (await asyncio.wait_for(proc.stdout.readline(), 30)).decode().rstrip("\n")
+            response = decode_json_response(response_line)
+            if owned:
+                decode_response(command, response)
+            entries.append(dict(label=label, command=command, request=payload,
+                                request_line=line, response_line=response_line, response=response))
+            for key in ("stateId", "nextStateId"):
+                if key in response:
+                    allocated.add(response[key])
+            if command == "goal.delete":
+                allocated.difference_update(payload["stateIds"])
+            return response
+
+        upstream = json.loads((fixtures / "upstream_pr1/capture.json").read_text())
+        golden = json.loads((fixtures / "canonical_graph_expectations.json").read_text())["goals"]
+        id_map = {}
+        renames = {
+            "unsupported_descriptor": "descriptor",
+            "admission_flag_present_without_validation": "checked_admission",
+            "logged_error_still_succeeds_without_diagnostics": "logged_error_rejected",
+        }
+        for old in upstream["interactions"]:
+            payload = dict(old["request"])
+            if "stateId" in payload:
+                payload["stateId"] = id_map.get(payload["stateId"], payload["stateId"])
+            if "stateIds" in payload:
+                payload["stateIds"] = sorted(allocated)
+            label = renames.get(old["label"], old["label"])
+            result = await call(label, old["command"], payload)
+            for key in ("stateId", "nextStateId"):
+                if key in old["response"] and key in result:
+                    id_map[old["response"][key]] = result[key]
+            if label in golden:
+                actual = result["goals"]
+                expected = golden[label]
+                assert len(actual) == len(expected)
+                for wire, target in zip(actual, expected):
+                    goal = decode_execution_goal(wire).goal
+                    canonical = goal.model_dump()
+                    assert canonical == target["canonical"], (label, canonical, target["canonical"])
+                    assert goal.state_fingerprint() == target["state_fingerprint"]
+                    dag = model_goal_to_dag(goal)
+                    assert dag_fingerprint(dag) == target["dag_fingerprint"]
+                    assert [node.as_dict() for node in dag.nodes] == target["nodes"]
+                    assert [list(edge) for edge in dag.edges] == target["edges"]
+                    assert dag.expression_root_id == target["expression_root_id"]
+                    assert dag.state_root_id == target["state_root_id"]
+                graph_checks.append(label)
+            if label == "logged_error_rejected":
+                assert result.get("tacticErrors") == ["capture error"]
+                assert "nextStateId" not in result
+                assert result["messages"][0]["data"] == "capture error"
+
+        root = (await call("validation_start", "goal.start", {"expr": "True"}))["stateId"]
+        for label, text, flag in [
+            ("skip", "skip", None),
+            ("warning_info", 'run_tac Lean.logWarning "warning evidence"\nrun_tac Lean.logInfo "information evidence"\ntrivial', None),
+            ("tagged_warning", "contract_tagged_warning", None),
+            ("nested_admission", "exact (by sorry)", "hasSorry"),
+            ("local_admission", "have h : True := by sorry\nexact h", "hasSorry"),
+            ("introduced_dependency_admission", "contract_dependency_sorry", "hasSorry"),
+            ("positive_unsafe", "contract_unsafe", "hasUnsafe"),
+            ("hidden_hole", "contract_hidden_hole", None),
+            ("delayed_hole", "contract_delayed_hole", None),
+            ("hidden_local_value", "contract_hidden_local_value", None),
+            ("missing_assignment", "contract_missing_assignment", "validation"),
+            ("failed_snapshot_mutation", "contract_failed_mutation", "failure"),
+            ("reuse_after_failure", "trivial", None),
+            ("trailing_input", "trivial\nthis_is_not_a_tactic", "parse"),
+        ]:
+            result = await call(label, "goal.tactic", {"stateId": root, "goalId": 0, "tactic": text})
+            if flag in ("hasSorry", "hasUnsafe"):
+                assert result[flag] is True and result["validation"]["checked"] is True
+            elif flag == "failure":
+                assert "tacticErrors" in result and "nextStateId" not in result
+            elif flag == "validation":
+                assert result.get("error") == "validation" and "nextStateId" not in result
+            elif flag == "parse":
+                assert "parseError" in result and "nextStateId" not in result
+            else:
+                assert "nextStateId" in result
+            if label in ("hidden_hole", "delayed_hole", "hidden_local_value"):
+                assert len(result["goals"]) == 1
+                solved = await call(label + "_solved", "goal.tactic", {
+                    "stateId": result["nextStateId"], "goalId": 0, "tactic": "trivial",
+                })
+                assert solved["goals"] == []
+            if label == "skip":
+                assert len(result["goals"]) == 1
+            if label == "warning_info":
+                assert {m["severity"] for m in result["messages"]} == {"warning", "information"}
+            if label == "reuse_after_failure":
+                assert result["messages"] == []
+        stored = await call("store_admission", "goal.tactic", {
+            "stateId": root, "goalId": 0, "tactic": "contract_store_admission",
+        })
+        used = await call("use_stored_admission", "goal.tactic", {
+            "stateId": stored["nextStateId"], "goalId": 0, "tactic": "exact ContractFixtures.storedAdmission",
+        })
+        assert used["hasSorry"] is True
+        identity = (await call("multiline_start", "goal.start", {"expr": "∀ (p : Prop), p → p"}))["stateId"]
+        result = await call("multiline_complete", "goal.tactic", {
+            "stateId": identity, "goalId": 0, "tactic": "intro p h\nexact h",
+        })
+        assert result["goals"] == []
+        # Exercise extra merged server operations without pretending they are owned-client APIs.
+        conv = (await call("conversion_start", "goal.start", {"expr": "(1 + 2) + 3 = 6"}))["stateId"]
+        result = await call("conversion_enter", "goal.tactic", {"stateId": conv, "mode": "conv"}, owned=False)
+        for index, text in enumerate(["lhs", "congr", "rfl", "rfl"]):
+            result = await call(f"conversion_step_{index}", "goal.tactic", {
+                "stateId": result["nextStateId"], "goalId": 0, "tactic": text,
+            }, owned=False)
+        assert [g["fragment"] for g in result["goals"]] == ["tactic"]
+        await call("validation_delete_all", "goal.delete", {"stateIds": sorted(allocated)})
+        assert (await call("validation_final_stat", "stat", {}))["nGoals"] == 0
+        proc.stdin.close()
+        await asyncio.wait_for(proc.wait(), 10)
+        stderr = (await stderr_task).decode()
+        assert proc.returncode == 0, stderr
+        args.output.mkdir(parents=True, exist_ok=False)
+        artifact = dict(kind="stage4-companion-live-capture", readiness_line=ready,
+                        interactions=entries, graph_checks=graph_checks,
+                        exit_code=proc.returncode, stderr=stderr,
+                        subprocess_reaped=True, final_allocations=len(allocated))
+        (args.output / "capture.json").write_text(json.dumps(artifact, ensure_ascii=False, indent=2) + "\n")
+        provenance = dict(base_commit=BASE, toolchain=toolchain,
+                          lean_version=subprocess.check_output(["lake", "env", "lean", "--version"], cwd=repo, text=True).strip(),
+                          repl_path=str(repl), repl_sha256=hashlib.sha256(repl.read_bytes()).hexdigest(),
+                          imports=["Mathlib", "Test.ContractFixtures"], lean_path=env["LEAN_PATH"],
+                          mathlib_expected_pin="29dcec074de168ac2bf835a77ef68bbe069194c5",
+                          mathlib_pin_verification="archive has no Git metadata; expected deployment pin",
+                          build_cache="copied reference archive cache; changed targets rebuilt",
+                          python_executable=sys.executable,
+                          decoder="existing revision-2 application codec", exchanges=len(entries),
+                          graph_checks=graph_checks, initial_state_count=0, final_state_count=0,
+                          subprocess_reaped=True, complete_theorem_certification=False)
+        (args.output / "provenance.json").write_text(json.dumps(provenance, indent=2) + "\n")
+        print(json.dumps(dict(exchanges=len(entries), graph_checks=graph_checks, output=str(args.output))))
+    finally:
+        if proc.returncode is None:
+            proc.kill()
+            await proc.wait()
+        if not stderr_task.done():
+            await stderr_task
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--repo", type=Path, default=Path.cwd())
+    parser.add_argument("--application", type=Path, required=True)
+    parser.add_argument("--mathlib", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    asyncio.run(capture(parser.parse_args()))
+
+
+if __name__ == "__main__":
+    main()
